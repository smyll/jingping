{
  "manifest_version": 3,
  "name": "净推 · X 评论清理",
  "version": "0.2.1",
  "description": "在本地折叠空泛附和、重复结论和模板式接话，让 X 评论区更清爽。无需 Token 或 API Key。",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "净推设置",
    "default_popup": "popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "净评 · X 评论折叠",
  "version": "0.1.1",
  "description": "在本地识别复述与模板式接话，自动折叠 X 评论。无需账号、API Key 或 Token。",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "净评设置",
    "default_popup": "popup.html"
  }
}
